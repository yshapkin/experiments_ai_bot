{
  "name": "experiments-ai-bot",
  "version": "1.0.0",
  "description": "Minimal private-chat Telegram echo bot",
  "main": "dist/functions/*.js",
  "scripts": {
    "test": "node --import tsx --test test/**/*.test.ts",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "@azure/functions": "4.16.5",
    "grammy": "1.46.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
