{
  "name": "experiments-ai-bot",
  "version": "1.0.0",
  "description": "Telegram user registration and status bot with gated Mini App access",
  "main": "dist/functions/*.js",
  "scripts": {
    "test": "node --import tsx --test test/**/*.test.ts",
    "dev": "tsx src/index.ts",
    "bot:build": "tsc -p tsconfig.build.json",
    "bot:typecheck": "tsc -p tsconfig.json --noEmit",
    "mini-app:dev": "vite src/mini-app",
    "mini-app:typecheck": "tsc -p src/mini-app/tsconfig.json",
    "mini-app:build": "vite build src/mini-app --outDir ../../mini-app/dist --emptyOutDir",
    "mini-app:preview": "vite preview src/mini-app --outDir ../../mini-app/dist",
    "test:mini-app:initialization": "node --import tsx --test test/mini-app-initialization.test.ts",
    "test:mini-app:build": "node --import tsx --test test/mini-app-build.test.ts",
    "build": "npm run bot:build && npm run mini-app:build",
    "typecheck": "npm run bot:typecheck && npm run mini-app:typecheck",
    "start": "node dist/index.js"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/functions": "4.16.5",
    "@azure/identity": "^4.13.3",
    "@azure/monitor-opentelemetry": "^1.20.0",
    "grammy": "1.46.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
